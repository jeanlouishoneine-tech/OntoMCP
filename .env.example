# OntoMCP environment variables — copy to .env and edit

# --- Core ---
ONTOMCP_DB_PATH=~/.ontomcp/cache.db         # SQLite cache file path
ONTOMCP_LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# --- FastAPI server ---
ONTOMCP_API_HOST=127.0.0.1                   # loopback by default; set to 0.0.0.0 to expose on the network
ONTOMCP_API_PORT=8000                        # REST API port

# --- FastMCP server ---
# Set to "sse" for GPT, Codex CLI, and remote MCP clients.
# Leave as "stdio" (default) for Claude Desktop and Claude Code.
ONTOMCP_TRANSPORT=stdio
ONTOMCP_MCP_HOST=127.0.0.1                    # set to 0.0.0.0 to expose on the network
ONTOMCP_MCP_PORT=8001                         # only used when TRANSPORT=sse

# --- Research profiles -----------------------------------------------------

# Load a research profile by name at startup. Accepts a shipped starter
# (pharma, biotech-molecular, plant-breeding, fermentation,
# clinical-rare-disease, microbiome, omics) or one you saved yourself.
# Unset = the ten built-in ontologies, i.e. today's behaviour.
# ONTOMCP_PROFILE=plant-breeding

# Administrator hard-lock: fixes searchable scope verbatim and force-disables
# profile writing. Highest precedence — overrides ONTOMCP_PROFILE. Env-only,
# because MCP clients configure servers through env.
# ONTOMCP_ONTOLOGIES=PO,TO,GO

# Where profiles are stored. Defaults to ~/.ontomcp/profiles/.
# ONTOMCP_PROFILE_DIR=~/.ontomcp/profiles

# Set to 0 to disable the escape hatch (the "no results in scope, but they exist
# over here" guidance) for strict determinism.
# ONTOMCP_ESCAPE_HATCH=0
